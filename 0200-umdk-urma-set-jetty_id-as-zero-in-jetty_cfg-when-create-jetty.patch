From 64be0c047d4e554cee7f1b56ec2e6dd504448f12 Mon Sep 17 00:00:00 2001
From: chenjingwei0113 <chenjingwei13@huawei.com>
Date: Fri, 29 May 2026 15:59:53 +0800
Subject: [PATCH] urma: set jetty_id as zero in jetty_cfg when create jetty

(cherry picked from commit 64b7412c66acab3163e67381c9670234e951cde1)
---
 src/urma/lib/urma/bond/bondp_api.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/urma/lib/urma/bond/bondp_api.c b/src/urma/lib/urma/bond/bondp_api.c
index fc129fef..b1875c58 100644
--- a/src/urma/lib/urma/bond/bondp_api.c
+++ b/src/urma/lib/urma/bond/bondp_api.c
@@ -1158,6 +1158,9 @@ static int bondp_create_pjetty(bondp_context_t *bdp_ctx, bondp_comp_t *bdp_jetty
         uint32_t i = bdp_jetty->enabled_indices[n];
         p_cfg.jfs_cfg.jfc = bdp_jfs_jfc->p_jfc[i];
         p_cfg.shared.jfr = bdp_jfr->p_jfr[i];
+        if (bdp_ctx->bonding_level == BONDP_BONDING_LEVEL_PORT) {
+            p_cfg.id = 0;
+        }
         if (bdp_rplc_jfc) {
             p_cfg.shared.jfc = bdp_rplc_jfc->p_jfc[i];
         }
-- 
