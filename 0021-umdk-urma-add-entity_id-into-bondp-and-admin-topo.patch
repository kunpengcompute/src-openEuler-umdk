From 3582e51cada13419947e12a43be2e831e403282b Mon Sep 17 00:00:00 2001
From: chenyutao <chenyutao2@huawei.com>
Date: Sat, 14 Feb 2026 14:13:54 +0800
Subject: [PATCH] urma: add entity_id into bondp and admin topo

Signed-off-by: chenyutao <chenyutao2@huawei.com>
(cherry picked from commit 4b4610a7e786c01c67cd51c927ff6d42cf05c06a)
---
 src/urma/lib/urma/bond/utils/topo_info.h     | 1 +
 src/urma/tools/urma_admin/admin_cmd_show.c   | 1 +
 src/urma/tools/urma_admin/admin_parameters.h | 1 +
 3 files changed, 3 insertions(+)

diff --git a/src/urma/lib/urma/bond/utils/topo_info.h b/src/urma/lib/urma/bond/utils/topo_info.h
index 5407905..8a15ab6 100644
--- a/src/urma/lib/urma/bond/utils/topo_info.h
+++ b/src/urma/lib/urma/bond/utils/topo_info.h
@@ -29,6 +29,7 @@ extern "C" {
 
 typedef struct bondp_topo_ue {
     uint32_t socket_id;
+    uint32_t entity_id;
     char primary_eid[EID_LEN];
     char port_eid[PORT_NUM][EID_LEN];
 } bondp_topo_ue_t;
diff --git a/src/urma/tools/urma_admin/admin_cmd_show.c b/src/urma/tools/urma_admin/admin_cmd_show.c
index 8089259..4d9f1d7 100644
--- a/src/urma/tools/urma_admin/admin_cmd_show.c
+++ b/src/urma/tools/urma_admin/admin_cmd_show.c
@@ -761,6 +761,7 @@ void admin_print_topo_map(tool_topo_map_t *topo_map, uint32_t node_id)
                 printf("\t UE %d:\n", iodie_idx);
             }
             printf("\t\t Socket id: %d\n", ue->socket_id);
+            printf("\t\t Entity id: %d\n", ue->entity_id);
             printf("\t\t Primary eid:\n");
             printf("\t\t\t %s\n", eid_str);
 
diff --git a/src/urma/tools/urma_admin/admin_parameters.h b/src/urma/tools/urma_admin/admin_parameters.h
index edffcd3..b42e2fe 100644
--- a/src/urma/tools/urma_admin/admin_parameters.h
+++ b/src/urma/tools/urma_admin/admin_parameters.h
@@ -220,6 +220,7 @@ typedef struct tool_res_seg_val {
 
 typedef struct tool_topo_ue {
     uint32_t socket_id;
+    uint32_t entity_id;
     char primary_eid[EID_LEN];
     char port_eid[PORT_NUM][EID_LEN];
 } tool_topo_ue_t;
-- 
2.28.0.windows.1

