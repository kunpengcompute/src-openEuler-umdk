From 105f2027683917cc7867dabce852502a68ab05bb Mon Sep 17 00:00:00 2001
From: chenyutao <chenyutao2@huawei.com>
Date: Tue, 21 Apr 2026 00:26:36 +0800
Subject: [PATCH 10/48] urma: bonding dev support affinity for specific iodie

Signed-off-by: chenyutao <chenyutao2@huawei.com>
(cherry picked from commit bc80d14ec6caa607c5c5f0f2656acaaaa13095b9)
---
 src/urma/lib/urma/bond/bondp_api.c            |  3 +
 src/urma/lib/urma/bond/bondp_datapath.c       |  8 +-
 .../lib/urma/bond/bondp_datapath_schedule.c   | 76 ++++++++++++-------
 .../lib/urma/bond/bondp_datapath_schedule.h   |  6 ++
 src/urma/lib/urma/bond/bondp_types.h          |  6 +-
 5 files changed, 65 insertions(+), 34 deletions(-)

diff --git a/src/urma/lib/urma/bond/bondp_api.c b/src/urma/lib/urma/bond/bondp_api.c
index b99b2817..a5e3c5e7 100644
--- a/src/urma/lib/urma/bond/bondp_api.c
+++ b/src/urma/lib/urma/bond/bondp_api.c
@@ -614,6 +614,9 @@ urma_jfs_t *bondp_create_jfs(urma_context_t *ctx, urma_jfs_cfg_t *cfg)
     atomic_init(&bdp_jfs->use_cnt.atomic_cnt, 0);
     bdp_jfs->send_jfc = CONTAINER_OF_FIELD(cfg->jfc, bondp_jfc_t, v_jfc);
     bdp_jfs->recv_jfc = NULL;
+    for (uint32_t i = 0; i < URMA_UBAGG_DEV_MAX_NUM; i++) {
+        atomic_init(&bdp_jfs->sqe_cnt[i], 0);
+    }
 
     const bondp_port_id_t *cfg_active_port_ids = NULL;
     uint32_t cfg_active_port_count = 0;
diff --git a/src/urma/lib/urma/bond/bondp_datapath.c b/src/urma/lib/urma/bond/bondp_datapath.c
index 8e91abc5..96d148c2 100644
--- a/src/urma/lib/urma/bond/bondp_datapath.c
+++ b/src/urma/lib/urma/bond/bondp_datapath.c
@@ -51,7 +51,7 @@ static urma_status_t comp_post_send(bondp_comp_t *comp, int send_idx, urma_jfs_w
         ret = URMA_EINVAL;
     }
     if (ret == URMA_SUCCESS) {
-        comp->sqe_cnt[send_idx] += 1;
+        atomic_fetch_add(&comp->sqe_cnt[send_idx], 1);
     }
     return ret;
 }
@@ -791,7 +791,7 @@ static cr_convert_ret_t handle_send_cr_with_store(bondp_jfc_t *bdp_jfc, int idx,
                     resend_wr_entry->target_idx != target_idx) {
                     continue;
                 }
-                bdp_comp->sqe_cnt[send_idx] -= 1;
+                atomic_fetch_sub(&bdp_comp->sqe_cnt[send_idx], 1);
                 if (resend_jfs_wr(resend_wr_entry, new_send_idx, new_target_idx) != 0) {
                     URMA_LOG_ERR("Failed to resend jfs wr, wr_id: %lu\n", wr_id);
                 }
@@ -819,7 +819,7 @@ static cr_convert_ret_t handle_send_cr_with_store(bondp_jfc_t *bdp_jfc, int idx,
         return CONVERT_SKIP;
     }
 
-    bdp_comp->sqe_cnt[send_idx] -= 1;
+    atomic_fetch_sub(&bdp_comp->sqe_cnt[send_idx], 1);
 
     uint32_t msn = 0;
     convert_pcr_to_vcr(cr, bdp_comp->bondp_ctx, &msn);
@@ -901,7 +901,7 @@ static cr_convert_ret_t bondp_handle_cr_no_store(bondp_context_t *bdp_ctx, int i
     if (is_recv_cr(cr)) {
         comp->rqe_cnt[idx] -= 1;
     } else {
-        comp->sqe_cnt[idx] -= 1;
+        atomic_fetch_sub(&comp->sqe_cnt[idx], 1);
     }
 
     uint32_t msn = 0;
diff --git a/src/urma/lib/urma/bond/bondp_datapath_schedule.c b/src/urma/lib/urma/bond/bondp_datapath_schedule.c
index fc4e4003..7a24f8ec 100644
--- a/src/urma/lib/urma/bond/bondp_datapath_schedule.c
+++ b/src/urma/lib/urma/bond/bondp_datapath_schedule.c
@@ -41,42 +41,47 @@ static int schedule_send_active_backup(const bondp_comp_t *bdp_comp, const bondp
     return -1;
 }
 
-static int schedule_send_balance(const bondp_comp_t *bdp_comp, const bondp_target_jetty_t *bdp_tjetty,
-                                 int *send_idx, int *target_idx, bondp_chip_id_info_t *info)
+static int schedule_send_balance_iodie(const bondp_comp_t *bdp_comp, const bondp_target_jetty_t *bdp_tjetty,
+                                       int *send_idx, int *target_idx, bondp_chip_id_info_t *info)
+{
+    URMA_LOG_ERR("Currently do not support iodie balance.");
+    return EINVAL;
+}
+
+static int schedule_send_balance_port(const bondp_comp_t *bdp_comp, const bondp_target_jetty_t *bdp_tjetty,
+                                      int *send_idx, int *target_idx, bondp_chip_id_info_t *info)
 {
     uint32_t min_active_count = MIN(bdp_comp->active_count, bdp_tjetty->active_count);
     int least_load_pos = -1;
     uint32_t least_load = UINT32_MAX;
+    int min, max;
 
-    if (info == NULL || info->src_chip_id == BONDP_CHIP_ID_MIN) {
-        for (uint32_t i = 0; i < min_active_count; i++) {
-            uint32_t active_idx = bdp_comp->active_indices[i];
-            if (!bdp_comp->valid[active_idx]) {
-                continue;
-            }
-
-            uint32_t sqe_cnt = bdp_comp->sqe_cnt[active_idx];
-            if (sqe_cnt < least_load) {
-                least_load = sqe_cnt;
-                least_load_pos = (int)i;
-            }
-        }
+    if (min_active_count == 0) {
+        URMA_LOG_ERR("Invalid min_active_count.\n");
+        return EINVAL;
+    }
+
+    if (info == NULL) {
+        min = 0;
+        max = URMA_UBAGG_DEV_MAX_NUM;
+    } else if (info->src_chip_id == BONDP_CHIP_ID_MIN) {
+        min = BONDP_CHIP_ID_MIN_START_PORT;
+        max = BONDP_CHIP_ID_MIN_END_PORT;
     } else {
-        if (min_active_count == 0) {
-            URMA_LOG_ERR("Invalid min_active_count.\n");
-            return EINVAL;
+        min = BONDP_CHIP_ID_MAX_START_PORT;
+        max = BONDP_CHIP_ID_MAX_END_PORT;
+    }
+
+    for (uint32_t i = 0; i < min_active_count; i++) {
+        uint32_t active_idx = bdp_comp->active_indices[i];
+        if (!bdp_comp->valid[active_idx] || active_idx < min || active_idx > max) {
+            continue;
         }
-        for (int i = min_active_count - 1; i >= 0; i--) {
-            uint32_t active_idx = bdp_comp->active_indices[i];
-            if (!bdp_comp->valid[active_idx]) {
-                continue;
-            }
-
-            uint32_t sqe_cnt = bdp_comp->sqe_cnt[active_idx];
-            if (sqe_cnt < least_load) {
-                least_load = sqe_cnt;
-                least_load_pos = i;
-            }
+
+        uint32_t sqe_cnt = atomic_load(&bdp_comp->sqe_cnt[active_idx]);
+        if (sqe_cnt < least_load) {
+            least_load = sqe_cnt;
+            least_load_pos = (int)i;
         }
     }
 
@@ -89,6 +94,19 @@ static int schedule_send_balance(const bondp_comp_t *bdp_comp, const bondp_targe
     return 0;
 }
 
+static int schedule_send_balance(const bondp_comp_t *bdp_comp, const bondp_target_jetty_t *bdp_tjetty,
+                                 int *send_idx, int *target_idx, bondp_chip_id_info_t *info)
+{
+    if (bdp_comp->bondp_ctx->bonding_level == BONDP_BONDING_LEVEL_PORT) {
+        return schedule_send_balance_port(bdp_comp, bdp_tjetty, send_idx, target_idx, info);
+    }
+    if (bdp_comp->bondp_ctx->bonding_level == BONDP_BONDING_LEVEL_IODIE) {
+        return schedule_send_balance_iodie(bdp_comp, bdp_tjetty, send_idx, target_idx, info);
+    }
+
+    return EINVAL;
+}
+
 static int schedule_recv_standalone(const bondp_comp_t *bdp_comp, int *recv_idx)
 {
     *recv_idx = (int)bdp_comp->active_indices[0];
diff --git a/src/urma/lib/urma/bond/bondp_datapath_schedule.h b/src/urma/lib/urma/bond/bondp_datapath_schedule.h
index 9c6d3117..b5f04317 100644
--- a/src/urma/lib/urma/bond/bondp_datapath_schedule.h
+++ b/src/urma/lib/urma/bond/bondp_datapath_schedule.h
@@ -18,6 +18,12 @@
 #define BONDP_CHIP_ID_MIN 1
 #define BONDP_CHIP_ID_MAX 2
 
+#define BONDP_CHIP_ID_MIN_START_PORT 2
+#define BONDP_CHIP_ID_MIN_END_PORT   10
+
+#define BONDP_CHIP_ID_MAX_START_PORT 11
+#define BONDP_CHIP_ID_MAX_END_PORT   19
+
 typedef struct bondp_chip_id_info {
     uint32_t src_chip_id;
     uint32_t dst_chip_id;
diff --git a/src/urma/lib/urma/bond/bondp_types.h b/src/urma/lib/urma/bond/bondp_types.h
index 37e7c4cc..6a119aff 100644
--- a/src/urma/lib/urma/bond/bondp_types.h
+++ b/src/urma/lib/urma/bond/bondp_types.h
@@ -235,7 +235,11 @@ typedef struct bondp_comp {
     bondp_jfc_t *send_jfc;
     bool valid[URMA_UBAGG_DEV_MAX_NUM];
     urma_target_seg_t *check_tseg[URMA_UBAGG_DEV_MAX_NUM];
-    uint32_t sqe_cnt[URMA_UBAGG_DEV_MAX_NUM];
+#ifndef __cplusplus
+    atomic_uint sqe_cnt[URMA_UBAGG_DEV_MAX_NUM];
+#else
+    std::atomic_uint sqe_cnt[URMA_UBAGG_DEV_MAX_NUM];
+#endif
     // recv
     bondp_jfc_t *recv_jfc;
     uint32_t rqe_cnt[URMA_UBAGG_DEV_MAX_NUM];
-- 
2.28.0.windows.1

