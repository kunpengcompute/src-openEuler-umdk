From e7c3a45207fec141d2f899c019fd958bf02eeb2f Mon Sep 17 00:00:00 2001
From: wanghang73 <wanghang73@huawei.com>
Date: Sun, 26 Apr 2026 16:36:40 +0800
Subject: [PATCH 47/48] urma: fix bonding device bug

(cherry picked from commit f02426f9f3f7670cd5ec7a63ae0384a7a3d0c5d4)
---
 src/urma/lib/urma/bond/bondp_link_recovery.c | 3 +++
 src/urma/lib/urma/bond/bondp_provider_ops.c  | 3 +--
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/urma/lib/urma/bond/bondp_link_recovery.c b/src/urma/lib/urma/bond/bondp_link_recovery.c
index 7e19b52e..d2d8f564 100644
--- a/src/urma/lib/urma/bond/bondp_link_recovery.c
+++ b/src/urma/lib/urma/bond/bondp_link_recovery.c
@@ -100,7 +100,10 @@ int bondp_rebuild_local_pjetty(bondp_health_task_t *task, int local_idx)
     }
 
     urma_jetty_id_t old_id = old_jetty->jetty_id;
+    /* Clear the slot before delete so concurrent readers never observe a freed jetty. */
+    bdp_jetty->p_jetty[local_idx] = NULL;
     if (urma_delete_jetty(old_jetty) != URMA_SUCCESS) {
+        bdp_jetty->p_jetty[local_idx] = old_jetty;
         URMA_LOG_ERR("Failed to delete pjetty at idx:%d\n", local_idx);
         return -1;
     }
diff --git a/src/urma/lib/urma/bond/bondp_provider_ops.c b/src/urma/lib/urma/bond/bondp_provider_ops.c
index 8d4e09b7..5e48de4a 100644
--- a/src/urma/lib/urma/bond/bondp_provider_ops.c
+++ b/src/urma/lib/urma/bond/bondp_provider_ops.c
@@ -369,6 +369,7 @@ static int bondp_create_pcontext(bondp_context_t *bdp_ctx, bondp_bonding_mode_t
                          m->dev->name, m->eid_index);
             return -1;
         }
+        bdp_ctx->p_ctxs[i] = ctx;
 
         int fd = ctx->async_fd;
         if (set_fd_noblock(fd) != 0) {
@@ -384,8 +385,6 @@ static int bondp_create_pcontext(bondp_context_t *bdp_ctx, bondp_bonding_mode_t
             return -1;
         }
 
-        bdp_ctx->p_ctxs[i] = ctx;
-
         if (bdp_ctx->bonding_mode == BONDP_BONDING_MODE_STANDALONE) {
             break;
         }
-- 
