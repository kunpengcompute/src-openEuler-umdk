From 2d2139f3927973fab8f5622cf96e51bb90bde878 Mon Sep 17 00:00:00 2001
From: LX_JS <tangzhedong1@h-partners.com>
Date: Tue, 3 Mar 2026 16:58:05 +0800
Subject: [PATCH] urma: Disable deletion operations on bonding_dev_0

(cherry picked from commit b832f4190417bb0f2cca26df4d70b235693a6c35)
---
 src/urma/tools/urma_admin/admin_cmd_agg.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/urma/tools/urma_admin/admin_cmd_agg.c b/src/urma/tools/urma_admin/admin_cmd_agg.c
index 20fe5482..283c8592 100644
--- a/src/urma/tools/urma_admin/admin_cmd_agg.c
+++ b/src/urma/tools/urma_admin/admin_cmd_agg.c
@@ -84,6 +84,19 @@ static int admin_cmd_agg_del(urma_eid_t eid)
 
     args.in.agg_eid = eid;
 
+    /* Hacky: bonding_dev_0 is hardcoded in other components. Deletion is disabled for now. */
+    urma_init_attr_t init_attr = {0};
+
+    urma_init(&init_attr);
+    urma_device_t *urma_dev = urma_get_device_by_eid(eid, URMA_TRANSPORT_UB);
+    bool is_dev_disallowed = strcmp(urma_dev->name, "bonding_dev_0");
+    urma_uninit();
+
+    if (is_dev_disallowed == 0) {
+        printf("bonding_dev_0 cannot be deleted now.\n");
+        return -1;
+    }
+
     hdr.command = CMD_AGG_DEL;
     hdr.args_addr = (uint64_t)(uintptr_t)&args;
     hdr.args_len = sizeof(args);
-- 
