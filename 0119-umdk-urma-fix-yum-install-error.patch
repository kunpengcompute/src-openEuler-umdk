From 8850bd6c5df08f353ffeea59dfbdd5f85fe236d1 Mon Sep 17 00:00:00 2001
From: luyicai <luyicai1994@yeah.net>
Date: Tue, 21 Apr 2026 21:24:06 +0800
Subject: [PATCH 14/48] urma: fix yum install error

Fix RPM installation failure due to file/directory conflict

Signed-off-by: luyicai <luyicai1994@yeah.net>
---
 umdk.spec | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/umdk.spec b/umdk.spec
index 25a396bc..b33cc630 100644
--- a/umdk.spec
+++ b/umdk.spec
@@ -340,6 +340,11 @@ fi
     /var/lib/ub/umdk/urma/gcov/%{name}/
 %endif
 
+%pre urma-tools
+if [ -d /usr/bin/urma_admin ] && [ ! -L /usr/bin/urma_admin ]; then
+    rm -rf /usr/bin/urma_admin
+fi
+
 %files urma-tools
 %defattr(-,root,root)
     %{_bindir}/urma_admin
-- 
2.28.0.windows.1

