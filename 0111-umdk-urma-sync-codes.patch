-    node = wr_buf_hmap_get(map, key);
-    if (node == NULL) {
-        return NULL;
-    }
-    ub_hmap_remove(map, &node->hh);
-    return node;
-}
-
-void wr_buf_hmap_traverse_and_remove(wr_buf_hmap_t *map, int (*func)(void *))
-{
