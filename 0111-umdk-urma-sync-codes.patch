-    wr_buf_node_t *node;
-
-    node = wr_buf_hmap_get(map, key);
-    if (node == NULL) {
-        return -1;
-    }
-    ub_hmap_remove(map, &node->hh);
-    free(node);
-    return 0;
-}
-
-wr_buf_node_t *wr_buf_hmap_move_out(wr_buf_hmap_t *map, uint32_t key)
