From c7791da2d89aff679fcb0c77b519afa636c3346c Mon Sep 17 00:00:00 2001
From: chenyutao <chenyutao2@huawei.com>
Date: Tue, 24 Mar 2026 20:57:43 +0800
Subject: [PATCH 10/10] urma: add max jetty config check for urma_perftest

Signed-off-by: chenyutao <chenyutao2@huawei.com>
(cherry picked from commit c6b5f037f74dcfc2a7358b788d7229ccc31d4703)
---
 src/urma/lib/uvs/core/CMakeLists.txt           | 18 +++++++++++++++++-
 .../tools/urma_perftest/perftest_parameters.c  |  2 +-
 .../tools/urma_perftest/perftest_parameters.h  |  2 +-
 3 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/src/urma/lib/uvs/core/CMakeLists.txt b/src/urma/lib/uvs/core/CMakeLists.txt
index 13f7717e..613752ea 100644
--- a/src/urma/lib/uvs/core/CMakeLists.txt
+++ b/src/urma/lib/uvs/core/CMakeLists.txt
@@ -7,6 +7,22 @@ add_library(tpsa SHARED
     ${TPSA_SO_DIR_SRCS}
 )
 
+if("${OPENSSL_LIBRARIES}" STREQUAL "")
+    find_package(OpenSSL REQUIRED)
+    if(OPENSSL_FOUND)
+        message(STATUS "OpenSSL found: ${OPENSSL_VERSION}")
+        message(STATUS "OpenSSL libraries: ${OPENSSL_LIBRARIES}")
+    else()
+        message(FATAL_ERROR "OpenSSL not found.")
+    endif()
+else()
+    find_package(ZLIB REQUIRED)
+    if(ZLIB_FOUND)
+        include_directories(${ZLIB_INCLUDE_DIRS})
+    endif()
+endif()
+
+
 set(PROJECT_VERSION "0.0.2")
 set(PROJECT_VERSION_MAJOR "0")
 
@@ -26,7 +42,7 @@ target_include_directories(tpsa
         ${CMAKE_SOURCE_DIR}/urma/common/include
 )
 
-target_link_libraries(tpsa urma_common_static nl-genl-3 nl-3 ssl crypto)
+target_link_libraries(tpsa urma_common_static nl-genl-3 nl-3 ${ZLIB_LIBRARIES} ${OPENSSL_LIBRARIES})
 
 install(TARGETS tpsa
     DESTINATION /usr/lib64
diff --git a/src/urma/tools/urma_perftest/perftest_parameters.c b/src/urma/tools/urma_perftest/perftest_parameters.c
index 20b7cfb5..624d1fbf 100644
--- a/src/urma/tools/urma_perftest/perftest_parameters.c
+++ b/src/urma/tools/urma_perftest/perftest_parameters.c
@@ -1219,7 +1219,7 @@ int check_local_cfg(perftest_config_t *cfg)
         if (cfg->credit_threshold == 0 || cfg->credit_threshold + cfg->jfs_post_list > cfg->jfr_depth) {
             cfg->credit_threshold = cfg->jfr_depth - (cfg->jfr_depth / PERFTEST_DEF_CREDIT_RATE);
             (void)fprintf(stderr, "credit_threshold out of range (1 ~ %u), change to %u.\n",
-                cfg->jfr_depth - cfg->jfs_post_list, cfg->credit_notify_cnt);
+                cfg->jfr_depth - cfg->jfs_post_list, cfg->credit_threshold);
         }
         if (cfg->trans_mode == URMA_TM_UM) {
             (void)fprintf(stderr, "Credit DOES NOT take effect in UM trans_mode.\n");
diff --git a/src/urma/tools/urma_perftest/perftest_parameters.h b/src/urma/tools/urma_perftest/perftest_parameters.h
index 833ca4c0..e174fc55 100644
--- a/src/urma/tools/urma_perftest/perftest_parameters.h
+++ b/src/urma/tools/urma_perftest/perftest_parameters.h
@@ -61,7 +61,7 @@
 
 // value range of perftest jfr_depth
 #define PERFTEST_JFR_DEPTH_MIN  (1)
-#define PERFTEST_JFR_DEPTH_MAX  (0x4000)
+#define PERFTEST_JFR_DEPTH_MAX  (0x8000)
 
 // value range of perftest cq_mod
 #define PERFTEST_CQ_MOD_MIN  (1)
-- 
