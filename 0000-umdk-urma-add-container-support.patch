+typedef struct admin_show_ubep {
+    struct ub_list node;
+    char dev_name[URMA_ADMIN_MAX_DEV_NAME];
+    urma_device_attr_t dev_attr;
+    urma_transport_type_t tp_type;
+    urma_eid_info_t *eid_list;
+    char net_dev_name[URMA_ADMIN_MAX_DEV_NAME];
+} admin_show_ubep_t;
