+            }
+            case UBCORE_RES_DEV_JTGRP_CNT: {
+                (void)printf("\n------JETTY_GROUP------\n");
+                (void)printf("jetty_group_cnt     :%u \n", nla_get_u32(nla));
+                break;
+            }
+            case UBCORE_RES_DEV_RC_CNT: {
