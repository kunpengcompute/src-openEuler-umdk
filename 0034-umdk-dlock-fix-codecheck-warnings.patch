From be84179da05173bd77904ff00375f51a90422ec0 Mon Sep 17 00:00:00 2001
From: huying <huying21@huawei.com>
Date: Fri, 6 Feb 2026 14:19:19 +0800
Subject: [PATCH] dlock: fix codecheck warnings

(cherry picked from commit d5f61a82f931d3a0cb3193431c6dbc936bd0781f)
---
 src/ulock/dlock/CMakeLists.txt                | 2 +-
 test/ulock/dlock/CMakeLists.txt               | 2 +-
 test/ulock/dlock/dlock_test/test_dlock_comm.h | 3 ++-
 3 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/ulock/dlock/CMakeLists.txt b/src/ulock/dlock/CMakeLists.txt
index 0a7b6f6..a18db5f 100644
--- a/src/ulock/dlock/CMakeLists.txt
+++ b/src/ulock/dlock/CMakeLists.txt
@@ -6,7 +6,7 @@ set(CMAKE_C_COMPILER "/usr/bin/gcc")
 
 set(CMAKE_FLAGS_PUBILC " -Wall -Werror -Wfloat-equal -Wtrampolines -Wextra -Wno-missing-field-initializers -Wno-unused-parameter -g -O2 -rdynamic -Wl,-z,noexecstack,-z,relro,-z,now \
 -fno-strict-aliasing -fstack-protector-strong -D_FORTIFY_SOURCE=2 -fPIE -pie -fPIC -funsigned-char -Wformat=2 -Wdate-time -Wswitch-default -Wshadow \
--fno-common")
+-fno-common -s")
 
 if("${UB_AGG_DIS}" STREQUAL "enable")
     set(UB_AGG "disable")
diff --git a/test/ulock/dlock/CMakeLists.txt b/test/ulock/dlock/CMakeLists.txt
index eb8ce7a..3662b59 100644
--- a/test/ulock/dlock/CMakeLists.txt
+++ b/test/ulock/dlock/CMakeLists.txt
@@ -5,7 +5,7 @@ cmake_minimum_required(VERSION 3.14.1)
 
 project(dlock_ut_gtest)
 
-add_compile_options(-Wall -Wno-noexcept-type -Wno-pmf-conversions -fno-access-control -fPIC -fno-omit-frame-pointer)
+add_compile_options(-Wall -Wno-noexcept-type -Wno-pmf-conversions -fno-access-control -fPIC -fno-omit-frame-pointer -s)
 set(CMAKE_C_STANDARD 11)
 set(CMAKE_CXX_STANDARD 11)
 
diff --git a/test/ulock/dlock/dlock_test/test_dlock_comm.h b/test/ulock/dlock/dlock_test/test_dlock_comm.h
index 8e029bf..e8afc0c 100644
--- a/test/ulock/dlock/dlock_test/test_dlock_comm.h
+++ b/test/ulock/dlock/dlock_test/test_dlock_comm.h
@@ -93,7 +93,8 @@ struct dlock_primary_cfg {
 extern struct test_dlock_cfg g_test_dlock_cfg;
 
 int generate_ssl_ca(std::string &pwd, std::string &path, std::string &file_suffix, int days);
-int generate_ssl_crt(struct dlock_ssl_ca_info &ca_info, std::string &pwd, std::string &path, std::string &file_suffix, int days);
+int generate_ssl_crt(struct dlock_ssl_ca_info &ca_info, std::string &pwd, std::string &path,
+    std::string &file_suffix, int days);
 int generate_ssl_file(void);
 int delete_ssl_file(void);
 void server_get_prkey_pwd(char **prkey_pwd, int *prkey_pwd_len);
-- 
2.28.0.windows.1

