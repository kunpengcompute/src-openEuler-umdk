From 97ac892711dc3631f594dea3593fd9ef908d5c73 Mon Sep 17 00:00:00 2001
From: LX_JS <tangzhedong1@h-partners.com>
Date: Mon, 9 Mar 2026 17:53:51 +0800
Subject: [PATCH] uram: urma_perftest cleancode

(cherry picked from commit 064d702b3a35413867ff8bd127fa6cdc62145d61)
---
 .../tools/urma_perftest/perftest_resources.c   | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/src/urma/tools/urma_perftest/perftest_resources.c b/src/urma/tools/urma_perftest/perftest_resources.c
index 396053ae..a27a1373 100644
--- a/src/urma/tools/urma_perftest/perftest_resources.c
+++ b/src/urma/tools/urma_perftest/perftest_resources.c
@@ -184,7 +184,7 @@ static int init_device(perftest_context_t *ctx, perftest_config_t *cfg)
     ctx->eid = ctx->urma_ctx->eid;
 
     if (cfg->enable_aggr_mode) {
-        status = urma_set_context_opt( ctx->urma_ctx, URMA_OPT_AGGR_MODE, &cfg->aggr_mode, sizeof(cfg->aggr_mode));
+        status = urma_set_context_opt(ctx->urma_ctx, URMA_OPT_AGGR_MODE, &cfg->aggr_mode, sizeof(cfg->aggr_mode));
         if (status != URMA_SUCCESS) {
             (void)fprintf(stderr, "Failed to set aggregation mode, status:%d!\n", (int)status);
             goto del_ctx;
@@ -700,14 +700,14 @@ static int register_mem(perftest_context_t *ctx, perftest_config_t *cfg)
     ctx->page_size = cfg->page_size;
     if (cfg->use_huge_page) {
         switch (cfg->huge_page) {
-        case UB_HUGE_PAGE_SIZE_2MB:
-            ctx->page_size = page_size_2MB;
-            break;
-        case UB_HUGE_PAGE_SIZE_1GB:
-            ctx->page_size = page_size_1GB;
-            break;
-        default:
-            break;
+            case UB_HUGE_PAGE_SIZE_2MB:
+                ctx->page_size = page_size_2MB;
+                break;
+            case UB_HUGE_PAGE_SIZE_1GB:
+                ctx->page_size = page_size_1GB;
+                break;
+            default:
+                break;
         }
     }
 
