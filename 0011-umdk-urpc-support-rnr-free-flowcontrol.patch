+            printf("    send cnt: %u\n", g_umq_info_list[i].send_rsp_cnt);
+            printf("    eagain cnt: %u\n", g_umq_info_list[i].eagain_cnt);
+            printf("--------------------------------------------------\n");
+        }
+        printf("=======================================================\n");
+    }
+    return NULL;
+}
