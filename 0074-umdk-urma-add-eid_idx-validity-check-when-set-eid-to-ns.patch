From 3fb34ae439733a089b242ab02f5cd53d6f8672c9 Mon Sep 17 00:00:00 2001
From: duelu <luyizhou1@huawei.com>
Date: Sat, 14 Mar 2026 11:41:31 +0800
Subject: [PATCH] urma: add eid_idx validity check when set eid to ns

(cherry picked from commit 526e554940a4ee2da38d76ac1764b310b33a0e7e)
---
 src/urma/tools/urma_admin/admin_cmd_eid.c    |  7 +++++
 src/urma/tools/urma_admin/admin_file_ops.c   | 31 ++++++++++++++++++++
 src/urma/tools/urma_admin/admin_parameters.h |  1 +
 3 files changed, 39 insertions(+)

diff --git a/src/urma/tools/urma_admin/admin_cmd_eid.c b/src/urma/tools/urma_admin/admin_cmd_eid.c
index 6c0be38e..9198cd0d 100644
--- a/src/urma/tools/urma_admin/admin_cmd_eid.c
+++ b/src/urma/tools/urma_admin/admin_cmd_eid.c
@@ -201,6 +201,13 @@ static int cmd_eid_set_mode(admin_config_t *cfg)
 static int cmd_eid_set_ns(admin_config_t *cfg)
 {
     int ret;
+    
+    /* Validate EID index validity */
+    if (!admin_is_eid_idx_valid(cfg->dev_name, cfg->idx)) {
+        (void)printf("EID index %u is invalid or not configured\n", cfg->idx);
+        return -EINVAL;
+    }
+    
     if ((ret = pop_arg_ns(cfg)) != 0) {
         return ret;
     }
diff --git a/src/urma/tools/urma_admin/admin_file_ops.c b/src/urma/tools/urma_admin/admin_file_ops.c
index cd6f148b..d253f6ee 100644
--- a/src/urma/tools/urma_admin/admin_file_ops.c
+++ b/src/urma/tools/urma_admin/admin_file_ops.c
@@ -298,3 +298,34 @@ void admin_read_eid_list(const char *sysfs_path, urma_eid_info_t *eid_list, uint
         }
     }
 }
+
+bool admin_is_eid_idx_valid(const char *dev_name, uint32_t eid_index)
+{
+    char tmp_eid[VALUE_LEN_MAX] = {0};
+    char tmp_value[VALUE_LEN_MAX] = {0};
+    char *sysfs_path = NULL;
+    urma_eid_info_t eid_info = {0};
+    
+    if (snprintf(tmp_eid, VALUE_LEN_MAX, "eids/eid%u", eid_index) <= 0) {
+        (void)printf("snprintf failed, eid idx: %u.\n", eid_index);
+        return false;
+    }
+
+    sysfs_path = calloc(1, DEV_PATH_MAX);
+    if (sysfs_path == NULL) {
+        return false;
+    }
+    if (admin_merge_sysfs_path(sysfs_path, SYS_CLASS_PATH, dev_name) != 0 ||
+        admin_parse_file_str(sysfs_path, tmp_eid, tmp_value, VALUE_LEN_MAX) <= 0 ||
+        admin_str_to_eid(tmp_value, &eid_info.eid) != 0 ||
+        eid_info.eid.in4.prefix == 0) {
+        goto free_sysfs_path;
+    }
+
+    free(sysfs_path);
+    return true;
+
+free_sysfs_path:
+    free(sysfs_path);
+    return false;
+}
diff --git a/src/urma/tools/urma_admin/admin_parameters.h b/src/urma/tools/urma_admin/admin_parameters.h
index feacff8e..8bf5a60c 100644
--- a/src/urma/tools/urma_admin/admin_parameters.h
+++ b/src/urma/tools/urma_admin/admin_parameters.h
@@ -318,5 +318,6 @@ int pop_arg_eid_idx(admin_config_t *cfg);
 int pop_arg_eid_mode(admin_config_t *cfg);
 
 int admin_get_ns_fd(const char *ns);
+bool admin_is_eid_idx_valid(const char *dev_name, uint32_t eid_index);
 
 #endif
