Subject: [PATCH] urma: remove unused bondp code

(cherry picked from commit 49d74521a6f5ccd582dbef8b4627341040f979eb)
---
 src/urma/lib/urma/bond/bondp_api.c     | 136 ++++++++++++-------------
 src/urma/lib/urma/bond/bondp_segment.c |   4 +-
 src/urma/lib/urma/bond/bondp_types.h   |   1 -
 3 files changed, 64 insertions(+), 77 deletions(-)

diff --git a/src/urma/lib/urma/bond/bondp_api.c b/src/urma/lib/urma/bond/bondp_api.c
index 7813218b..4a800105 100644
--- a/src/urma/lib/urma/bond/bondp_api.c
+++ b/src/urma/lib/urma/bond/bondp_api.c
@@ -868,12 +868,10 @@ int bondp_user_ctl(urma_context_t *ctx, urma_user_ctl_in_t *in, urma_user_ctl_ou
     return 0;
 }
 
-/**
- * Import primary ports for each plane in matrix server
- */
-static int import_primary_ports(bondp_context_t *bdp_ctx, bondp_target_jetty_t *bdp_tjetty,
-                                urma_bond_id_info_out_t *rvjetty_info, urma_rjetty_t *rjetty,
