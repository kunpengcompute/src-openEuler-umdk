+    (void)fc->ops.local_rx_allocated_dec(fc, return_credit);
+    umq_ub_shared_credit_return_ack(queue, return_credit);
+}
+
+void umq_ub_shared_credit_return_ack_handle(ub_queue_t *queue, umq_ub_imm_t *imm)
+{
+    return;
+}
