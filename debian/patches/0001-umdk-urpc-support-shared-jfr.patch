-static inline uint32_t get_actual_send_num(umq_buf_t *req_buf, umq_buf_t *bad)
-{
-    uint32_t num = 0;
-    umq_buf_t *tmp = req_buf;
-    while (tmp) {
-        if (tmp == bad) {
