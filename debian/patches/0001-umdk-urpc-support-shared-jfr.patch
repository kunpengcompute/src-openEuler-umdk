+static inline int umq_perftest_write_perf_recode_msg(char *str_buf, int all_str_len, const char *format, ...)
+{
+    if (all_str_len <= 0) {
+        return 0;
+    }
+
+    va_list args;
+    va_start(args, format);
+    int ret = vsnprintf(str_buf, all_str_len, format, args);
+    va_end(args);
+    return ret;
+}
