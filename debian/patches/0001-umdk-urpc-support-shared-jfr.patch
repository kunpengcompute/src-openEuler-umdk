-static inline void urpc_timing_wheel_lock(urpc_timing_wheel_t *tw)
-{
-    pthread_spin_lock(&tw->lock);
-}
-
-static inline void urpc_timing_wheel_unlock(urpc_timing_wheel_t *tw)
-{
