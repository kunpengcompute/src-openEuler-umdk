+        } while (send_cnt != 1 && !is_perftest_force_quit());
+
+        // recv return, release rx
+        recv_cnt = 0;
+        do {
+            ret = umq_poll(umqh, UMQ_IO_RX, &rx_buf, 1);
+            if (ret < 0) {
+                LOG_PRINT("umq poll rx failed, ret %d\n", ret);
+                goto FINISH;
+            }
+            if (ret == 1) {
+                ret = process_flow_control_buf(umqh, rx_buf);
+                if (ret < 0) {
+                    goto FINISH;
+                }
+            }
