-    ret = urpc_keepalive_task_init();
-    if (ret != URPC_SUCCESS) {
-        return URPC_FAIL;
-    }
-
-    ret = urpc_keepalive_probe_init(cfg);
-    if (ret != URPC_SUCCESS) {
-        urpc_keepalive_task_uninit();
-        return URPC_FAIL;
-    }
-
-    urpc_manage_job_register(URPC_MANAGE_JOB_TYPE_LISTEN, urpc_keepalive_check, NULL, MS_PER_SEC);
