-            break;
-        case UMQ_OPC_SEND_IMM:
-            if (imm.bs.type == IMM_TYPE_MEM && imm.mem_import.sub_type == IMM_TYPE_MEM_IMPORT) {
-                umq_buf_free(buf);
-                return UMQ_CONTINUE_FLAG;
-            }
-            break;
-        default:
-            break;
-    }
-    return UMQ_SUCCESS;
-}
