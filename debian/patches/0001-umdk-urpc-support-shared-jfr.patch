+     * ├── mem information 0(TLV)                 URPC_TLV_TYPE_MEM_INFO
+     * ├── mem information 1(TLV)                 URPC_TLV_TYPE_MEM_INFO
+     * └── ... */
+
+    // 1. search queue information
+    char *meminfo_buf = meminfo_arr_tlv_head->value.user_data;
