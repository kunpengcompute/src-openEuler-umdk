+    if (urpc_id_generator_alloc(&g_urpc_thread_a_ctx.id_generator, 0, &id) != 0) {
+        UTIL_LOG_ERR("urpc thread num exceeds max %d\n", URPC_THREAD_NUM_MAX);
+        return -1;
