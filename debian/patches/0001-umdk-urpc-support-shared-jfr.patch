+#include "dfx.h"
+
+int urpc_dfx_init(void)
+{
+    if (version_cmd_init() != 0) {
+        return -1;
+    }
+
+    if (stats_cmd_init() != 0) {
+        goto VERSION_UNSET;
+    }
+
+    if (queue_info_cmd_init() != 0) {
+        goto STATS_UNSET;
