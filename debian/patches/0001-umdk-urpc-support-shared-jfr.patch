+{
+    if (is_feature_enable(URPC_FEATURE_KEEPALIVE)) {
+        return g_keepalive_probe_ctx.cfg.keepalive_check_time;
+    }
+    return KEEPALIVE_CHECK_TIME_DEFAULT;
+}
