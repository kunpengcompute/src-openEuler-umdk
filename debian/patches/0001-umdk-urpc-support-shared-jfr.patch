-    }
-
-    if (umq_io_buf_malloc(cfg->buf_mode, total_io_buf_size) == NULL) {
-        goto ROLLBACL_UB_CTX;
-    }
-
-    qbuf_pool_cfg_t qbuf_cfg = {
-        .buf_addr = umq_io_buf_addr(),
-        .total_size = umq_io_buf_size(),
