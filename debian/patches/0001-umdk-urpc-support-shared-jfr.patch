-    if (urpc_role_get() == URPC_ROLE_CLIENT || !is_feature_enable(URPC_FEATURE_KEEPALIVE) ||
-        urpc_state_get() != URPC_STATE_INIT) {
-        return;
-    }
-
-    urpc_keepalive_task_timeout();
-}
