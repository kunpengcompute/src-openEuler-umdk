-
-    do {
-        g_urpc_perftest_ctx.accept_fd = accept(g_urpc_perftest_ctx.fd, (struct sockaddr *)(void *)&addr, &len);
-        if (g_urpc_perftest_ctx.accept_fd >= 0) {
-            break;
