-    }
-    memcpy(&(info->key), key, sizeof(urpc_instance_key_t));
-
-    int ret = URPC_FAIL;
-    for (uint8_t retry_cnt = 0; retry_cnt < SERVER_CHID_INSERT_MAX_RETRY_NUM; ++retry_cnt) {
-        info->mapped_id = crypto_gen_rand_channel_id(info->id);
