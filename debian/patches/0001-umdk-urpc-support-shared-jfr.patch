+static int attach_msg_v1_deserialize_qinfo_arr(urpc_tlv_arr_head_t *qinfo_arr_tlv_head, urpc_qinfo_arr_v1_t *qinfo_arr)
+{
+    /* array(TL)                                    URPC_TLV_TYPE_ARRAY
+     * ├── array number
+     * ├── queue information 0(TLV)                 URPC_TLV_TYPE_QUEUE_INFO
