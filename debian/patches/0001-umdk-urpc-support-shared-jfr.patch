+{
+    if (win == 0 || !fc->enabled) {
+        return;
+    }
+
+    (void)fc->ops.remote_rx_window_inc(fc, win);
+}
+
+static inline uint16_t umq_ub_window_dec(ub_flow_control_t *fc, ub_queue_t *queue, uint16_t win)
+{
+    if (win == 0 || !fc->enabled) {
+        return win;
+    }
+
+    if (!fc->remote_get) {
+        umq_ub_window_read(fc, queue);
+        return 0;
+    }
+
+    return fc->ops.remote_rx_window_dec(fc, win);
+}
