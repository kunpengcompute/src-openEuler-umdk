-        if ((memcmp(&eid_node->eid, remote_eid, sizeof(urma_eid_t)) == 0) && (info->pid == eid_node->pid)) {
-            find = true;
-            break;
-        }
-    }
-
-    if (find) {
-        *remote_eid_id = eid_node->remote_eid_id;
