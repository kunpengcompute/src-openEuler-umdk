+
+    if (dbuf_cmd_init() != 0) {
+        goto PERF_UNSET;
+    }
+
+    if (channel_info_cmd_init() != 0) {
+        goto DBUF_UNINIT;
+    }
+
+    if (handshaker_cmd_init() != 0) {
+        goto CHANNEL_UNINIT;
+    }
+    return 0;
+
+CHANNEL_UNINIT:
+    channel_info_cmd_uninit();
+DBUF_UNINIT:
+    dbuf_cmd_uninit();
+PERF_UNSET:
+    urpc_perf_cmd_uninit();
+QUEUE_UNSET:
+    queue_info_cmd_uninit();
+STATS_UNSET:
+    stats_cmd_uninit();
+VERSION_UNSET:
+    version_cmd_uninit();
+    return -1;
+}
+
+void urpc_dfx_uninit(void)
+{
