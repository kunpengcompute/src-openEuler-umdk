+    for (INIT_CONTAINER_PTR(NODE, urpc_hmap_first(HMAP), MEMBER);                \
+        ((NODE != OBJ_CONTAINING(NULL, NODE, MEMBER)) ?       \
+        (INIT_CONTAINER_PTR(NEXT, urpc_hmap_next(HMAP, &(NODE)->MEMBER), MEMBER), 1) :  \
+        ((NODE) = NULL, 0)); \
+        (NODE) = (NEXT))
+
