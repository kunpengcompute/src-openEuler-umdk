+    entry->cb = cb;
+    entry->args = args;
+    entry->timeout = timeout;
+    entry->timestamp = get_timestamp() + timeout;
+
+    entry->task_id = urpc_resource_release_id();
+    *id = entry->task_id;
+    urpc_resource_release_entry_insert(entry);
