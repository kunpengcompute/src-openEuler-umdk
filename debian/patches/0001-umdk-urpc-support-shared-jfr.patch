+    URPC_LIST_FOR_EACH_SAFE(cur, next, node, &g_urpc_resource_release_ctx.list) {
+        urpc_list_remove(&cur->node);
+        cur->cb(cur->args, true);
+        urpc_dbuf_free(cur);
+    }
