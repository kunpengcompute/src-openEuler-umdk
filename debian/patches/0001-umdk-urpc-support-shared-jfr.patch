-void urpc_query_timer_info(uint32_t chid, bool is_server, uint64_t *stats, int stats_len)
-{
-    urpc_timer_key_t key;
-    urpc_timer_key_fill(&key, chid, is_server);
-    urpc_timer_pool_entry_t *entry = NULL;
