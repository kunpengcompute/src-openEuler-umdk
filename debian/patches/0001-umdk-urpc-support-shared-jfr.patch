+        goto OUT;
+    }
+
+    urpc_tlv_head_t *qinfo_tlv_head = urpc_tlv_search_element(qinfo_buf, qinfo_len, URPC_TLV_TYPE_QUEUE_INFO);
+    for (uint32_t i = 0; i < qinfo_arr_tlv_head->value.arr_num; i++) {
+        // 2. deserialize queue information
