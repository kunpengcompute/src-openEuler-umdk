-    (void)memcpy(&eid_node->eid, remote_eid, sizeof(urma_eid_t));
-    urpc_hmap_insert(&remote_imported_info->remote_eid_id_table, &eid_node->node, hash);
-    pthread_mutex_unlock(&remote_imported_info->remote_eid_id_table_lock);
