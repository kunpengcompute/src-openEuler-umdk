+        return true;
+    }
+
+    if (next_print_cycle(last_time, ctx->rate_limited.interval_ms)) {
+        *print_count = 0;
+    }
+
+    if (*print_count < ctx->rate_limited.num) {
+        *print_count += 1;
+        return true;
