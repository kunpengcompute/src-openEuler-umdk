+    urpc_thread_job_t pre_job;
+    urpc_thread_job_t loop_job;
+    urpc_thread_job_t post_job;
+    pthread_t thread;
+    int id;
+    volatile urpc_thread_state_t state;
+} urpc_thread_param_t;
+
+static struct {
+    urpc_thread_param_t thread_param[URPC_THREAD_NUM_MAX];
+    urpc_id_generator_t id_generator;
+} g_urpc_thread_a_ctx;
+
