-    urpc_timer_fd_uninit();
-
-    urpc_timer_pool_uninit();
-
-    urpc_timing_wheel_stop(g_urpc_timing_wheel.tw);
-    pthread_spin_destroy(&g_urpc_timing_wheel.tw->lock);
-    urpc_dbuf_free(g_urpc_timing_wheel.tw);
