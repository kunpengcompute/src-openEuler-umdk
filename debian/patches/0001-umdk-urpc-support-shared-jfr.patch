+#define URPC_TIMER_MAGIC_NUM 0x33445577u
+#define URPC_TIMER_MIN_DELAY (10u)      /* 10ms */
+#define URPC_TIMER_MAX_DELAY 0xFFFFFFFu /* in ms, 3 days */
+#define URPC_TIMER_MAX_JOB 1000
