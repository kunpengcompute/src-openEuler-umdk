+static void urpc_perftest_run(perftest_framework_config_t *cfg)
+{
+    if (cfg->case_type == PERFTEST_CASE_QPS) {
+        urpc_perftest_print_qps(cfg);
+    } else {
+        urpc_perftest_print_latency(cfg);
+    }
+}
