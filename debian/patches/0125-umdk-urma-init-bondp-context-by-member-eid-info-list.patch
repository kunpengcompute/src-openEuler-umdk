-            if (epoll_ctl(bdp_ctx->v_ctx.async_fd, EPOLL_CTL_ADD, fd, &ev) != 0) {
-                URMA_LOG_ERR("failed to add fd: %u, errno: %d.\n", fd, errno);
-                goto roll_back;
-            }
-        }
-    }
-    return 0;
-
-roll_back:
-    for (j = 0; j < i; j++) {
