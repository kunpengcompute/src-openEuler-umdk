From d6bccb989df40843acd3261f33ac4c440a66b32b Mon Sep 17 00:00:00 2001
From: Bi Shulei <bishulei@huawei.com>
Date: Thu, 7 May 2026 22:00:33 +0800
Subject: [PATCH] urma: Fixed the chip_id and die_id validation logic.

(cherry picked from commit 8de99bf6863798757026aae809a23176e1396bd8)
---
 src/urma/lib/urma/bond/bondp_api.c     | 18 ++++++++++++------
 src/urma/lib/urma/bond/bondp_segment.c |  2 +-
 2 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/src/urma/lib/urma/bond/bondp_api.c b/src/urma/lib/urma/bond/bondp_api.c
index 9ff38056..37758e1f 100644
--- a/src/urma/lib/urma/bond/bondp_api.c
+++ b/src/urma/lib/urma/bond/bondp_api.c
@@ -380,17 +380,23 @@ static inline int get_matrix_port_p_idx(int primary_idx, int port_idx)
 static int convert_bond_port_id_to_active_index(const bondp_context_t *bdp_ctx, bondp_port_id_t port_id,
                                                 uint32_t *active_index)
 {
+    if (port_id.chip_id == 0 || port_id.chip_id > CHIP_NUM) {
+        URMA_LOG_ERR("Invalid primary chip_id=%u.\n", port_id.chip_id);
+        return -1;
+    }
+
+    if (port_id.die_id != 1) {
+        URMA_LOG_ERR("Invalid port_id.die_id=%u.\n", port_id.die_id);
+        return -1;
+    }
+
     if (port_id.port_idx == UINT8_MAX) {
-        if (port_id.chip_id > PRIMARY_EID_NUM) {
-            URMA_LOG_ERR("Invalid primary chip_id=%u.\n", port_id.chip_id);
-            return -1;
-        }
         *active_index = port_id.chip_id - 1;
         return 0;
     }
 
-    if (port_id.port_idx > PORT_NUM || port_id.chip_id > PRIMARY_EID_NUM) {
-        URMA_LOG_ERR("Invalid port id, chip_id=%u, port_idx=%u.\n", port_id.chip_id, port_id.port_idx);
+    if (port_id.port_idx > PORT_NUM) {
+        URMA_LOG_ERR("Invalid port_id.port_idx=%u.\n", port_id.port_idx);
         return -1;
     }
 
diff --git a/src/urma/lib/urma/bond/bondp_segment.c b/src/urma/lib/urma/bond/bondp_segment.c
index 1dd187ec..17cf22b7 100644
--- a/src/urma/lib/urma/bond/bondp_segment.c
+++ b/src/urma/lib/urma/bond/bondp_segment.c
@@ -161,7 +161,7 @@ static int bondp_create_vseg(bondp_context_t *bdp_ctx, bondp_tseg_t *bdp_seg, ur
     bdp_seg->v_tseg.seg.attr.value = seg_cfg->flag.value;
     bdp_seg->v_tseg.mva = seg_cfg->va;
     bdp_seg->v_tseg.urma_ctx = &bdp_ctx->v_ctx;
-    bdp_seg->v_tseg.user_ctx = (uint64_t)&bdp_seg->v_tseg;
+    bdp_seg->v_tseg.user_ctx = seg_cfg->user_ctx;
     bdp_seg->v_tseg.token_id = seg_cfg->token_id;
 
     in_seg_info.base = bdp_seg->v_tseg.seg;
-- 
