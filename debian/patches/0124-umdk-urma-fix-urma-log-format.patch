From f30dc00681a6da3f8bafd72202906bc486e7b48b Mon Sep 17 00:00:00 2001
From: chenyutao <chenyutao2@huawei.com>
Date: Fri, 24 Apr 2026 14:30:57 +0800
Subject: [PATCH 29/48] urma: fix urma log format urma log should end with \n

Signed-off-by: chenyutao <chenyutao2@huawei.com>
(cherry picked from commit 5d5f796a8159a44594217f761139f5c5b57b05a9)
---
 src/urma/lib/urma/bond/bondp_datapath_schedule.c |  2 +-
 src/urma/lib/urma/core/urma_perf.c               | 12 ++++++------
 src/urma/lib/uvs/core/tpsa_log.c                 |  2 +-
 3 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/src/urma/lib/urma/bond/bondp_datapath_schedule.c b/src/urma/lib/urma/bond/bondp_datapath_schedule.c
index 7a24f8ec..eff95205 100644
--- a/src/urma/lib/urma/bond/bondp_datapath_schedule.c
+++ b/src/urma/lib/urma/bond/bondp_datapath_schedule.c
@@ -44,7 +44,7 @@ static int schedule_send_active_backup(const bondp_comp_t *bdp_comp, const bondp
 static int schedule_send_balance_iodie(const bondp_comp_t *bdp_comp, const bondp_target_jetty_t *bdp_tjetty,
                                        int *send_idx, int *target_idx, bondp_chip_id_info_t *info)
 {
-    URMA_LOG_ERR("Currently do not support iodie balance.");
+    URMA_LOG_ERR("Currently do not support iodie balance.\n");
     return EINVAL;
 }
 
diff --git a/src/urma/lib/urma/core/urma_perf.c b/src/urma/lib/urma/core/urma_perf.c
index 85a44906..534fb968 100644
--- a/src/urma/lib/urma/core/urma_perf.c
+++ b/src/urma/lib/urma/core/urma_perf.c
@@ -289,7 +289,7 @@ urma_status_t urma_start_perf(void)
 {
     // singleton
     if (pthread_once(&g_perf_start_once, urma_perf_global_context_init) != 0) {
-        URMA_LOG_ERR("Urma perf failed to initialize performance record context");
+        URMA_LOG_ERR("Urma perf failed to initialize performance record context\n");
         return URMA_FAIL;
     }
     // reset context
@@ -301,11 +301,11 @@ urma_status_t urma_start_perf(void)
 urma_status_t urma_stop_perf(void)
 {
     if (!urma_perf_is_enabled()) {
-        URMA_LOG_WARN("Urma perf stop failed. perf is not started. ");
+        URMA_LOG_WARN("Urma perf stop failed. perf is not started.\n");
         return URMA_SUCCESS;
     }
     if (pthread_once(&g_perf_stop_once, urma_perf_global_context_uninit) != 0) {
-        URMA_LOG_ERR("Urma perf failed to uninitialize performance record context");
+        URMA_LOG_ERR("Urma perf failed to uninitialize performance record context\n");
         return URMA_FAIL;
     }
     g_urma_perf_record_enable = false;
@@ -348,7 +348,7 @@ urma_status_t urma_config_perf_attr(urma_perf_attr_t *perf_attr)
     // set thresh
     for (uint32_t i = 0; i < thresh_num; ++i) {
         if ((thresh_array[i] > URMA_PERF_MAX_THRESH_NS) || (thresh_array[i] == 0)) {
-            URMA_LOG_WARN("Urma perf config failed. thresh: %lu is invalid. \n", thresh_array[i]);
+            URMA_LOG_WARN("Urma perf config failed. thresh: %lu is invalid.\n", thresh_array[i]);
             continue;
         }
         if ((bucket_idx == 0) || (thresh_array[i] > g_urma_perf_record_ctx.thresh_ns[bucket_idx - 1])) {
@@ -368,7 +368,7 @@ urma_status_t urma_step_perf(urma_perf_record_type_t type, uint64_t delta)
     urma_perf_record_t *cur_record = &g_urma_perf_record_ctx.record_table[g_perf_record_index];
 
     if (!urma_perf_is_enabled()){
-        URMA_LOG_ERR("Urma perf step failed. perf record is not started or thread %d is not using. \n",
+        URMA_LOG_ERR("Urma perf step failed. perf record is not started or thread %d is not using.\n",
             g_perf_record_index);
         return URMA_ENOPERM;
     }
@@ -377,7 +377,7 @@ urma_status_t urma_step_perf(urma_perf_record_type_t type, uint64_t delta)
         return URMA_EINVAL;
     }
     if (delta < g_urma_perf_record_ctx.thresh_cycle[0]) {
-        URMA_LOG_WARN("Urma perf type %d delta is %lu, less than threshold %lu. \n", 
+        URMA_LOG_WARN("Urma perf type %d delta is %lu, less than threshold %lu.\n",
             type, delta, g_urma_perf_record_ctx.thresh_cycle[0]);
         return URMA_EINVAL;
     }
diff --git a/src/urma/lib/uvs/core/tpsa_log.c b/src/urma/lib/uvs/core/tpsa_log.c
index b1239259..d5247e9a 100644
--- a/src/urma/lib/uvs/core/tpsa_log.c
+++ b/src/urma/lib/uvs/core/tpsa_log.c
@@ -141,7 +141,7 @@ void tpsa_getenv_log_level(void)
     }
 
     if (strnlen(level_str, UVS_LOG_LEVEL_ENV_MAX_BUF_LEN) >= UVS_LOG_LEVEL_ENV_MAX_BUF_LEN) {
-        TPSA_LOG_ERR("Invalid parameter: log level str.");
+        TPSA_LOG_ERR("Invalid parameter: log level str.\n");
         return;
     }
 
-- 
2.28.0.windows.1

