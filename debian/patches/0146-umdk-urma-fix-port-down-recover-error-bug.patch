From bb390c352c76e4de811d43625a64b5d920556870 Mon Sep 17 00:00:00 2001
From: chenyutao <chenyutao2@huawei.com>
Date: Tue, 28 Apr 2026 00:38:56 +0800
Subject: [PATCH] urma: fix port down recover error bug

Signed-off-by: chenyutao <chenyutao2@huawei.com>
---
 src/urma/lib/urma/bond/bondp_datapath.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/urma/lib/urma/bond/bondp_datapath.c b/src/urma/lib/urma/bond/bondp_datapath.c
index 31e3b575..152e76b5 100644
--- a/src/urma/lib/urma/bond/bondp_datapath.c
+++ b/src/urma/lib/urma/bond/bondp_datapath.c
@@ -305,6 +305,7 @@ static urma_status_t bondp_post_send_wr_and_store(bondp_comp_t *bdp_comp, urma_j
         ret = schedule_send(wr->tjetty, bdp_comp, &send_idx, &target_idx, &info);
     }
     if (ret != 0) {
+        URMA_LOG_WARN("Failed to schedule send.\n");
         return URMA_FAIL;
     }
 
@@ -788,9 +789,17 @@ static cr_convert_ret_t handle_send_cr_with_store(bondp_jfc_t *bdp_jfc, int idx,
              * this error CQE is returned directly to the upper layer.
              */
             URMA_LOG_ERR("Failed to find valid port for retransmission.\n");
+            /* Port down can be recovered, currently for simplex mode */
+            if (cr->status == URMA_CR_LOC_ACCESS_ERR && bdp_comp->comp_type == BONDP_COMP_JFS) {
+                bdp_comp->valid[send_idx] = true;
+            }
             (void)pthread_spin_unlock(&bdp_comp->send_lock);
             goto CONVERT_CR;
         }
+        /* Port down can be recovered, currently for simplex mode */
+        if (cr->status == URMA_CR_LOC_ACCESS_ERR && bdp_comp->comp_type == BONDP_COMP_JFS) {
+            bdp_comp->valid[send_idx] = true;
+        }
 
         URMA_LOG_DEBUG("Resend from %d to %d\n", send_idx, new_send_idx);
 
-- 
