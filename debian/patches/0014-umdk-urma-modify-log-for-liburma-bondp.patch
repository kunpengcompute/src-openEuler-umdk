     urma_cmd_udrv_priv_t udata = { .in_addr = 0,      .in_len = 0,
         .out_addr = (uint64_t)&udata_out,             .out_len = sizeof(udata_out) };
 
-    if (urma_cmd_import_seg(ctx, &bdp_imprt_tseg->v_tseg, &cfg, &udata) != 0) {
