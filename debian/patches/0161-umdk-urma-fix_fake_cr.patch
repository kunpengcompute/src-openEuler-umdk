Subject: [PATCH] urma: fix_fake_cr

(cherry picked from commit 76fb2e6a5a54a59b86494fadf8d99e9ea2360a1c)
---
 src/urma/lib/urma/bond/bondp_datapath.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/urma/lib/urma/bond/bondp_datapath.c b/src/urma/lib/urma/bond/bondp_datapath.c
index 620e399e..c1e60f18 100644
--- a/src/urma/lib/urma/bond/bondp_datapath.c
+++ b/src/urma/lib/urma/bond/bondp_datapath.c
@@ -710,7 +710,7 @@ static cr_convert_ret_t handle_fake_cr_with_store(bondp_context_t *bdp_ctx, int
             break;
         }
     }
-    if (all_reported && !comp->modify_to_error) {
+    if (all_reported && comp->modify_to_error) {
         cr->local_id = get_comp_urma_jetty_id(comp)->id;
         /* Caller should copy this CR to output array. */
         put_comp(comp);
