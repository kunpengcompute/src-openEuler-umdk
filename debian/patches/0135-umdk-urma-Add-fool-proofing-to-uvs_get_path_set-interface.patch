From cf8724e4fab04ec77e8c69fa0dd509695244277b Mon Sep 17 00:00:00 2001
From: chenjingwei0113 <chenjingwei13@huawei.com>
Date: Thu, 23 Apr 2026 21:01:10 +0800
Subject: [PATCH 42/48] urma: Add fool-proofing to uvs_get_path_set interface

(cherry picked from commit f60f249c255ce816fb1dda5b4027eb5d2906ed7d)
---
 src/urma/lib/uvs/core/tpsa_api.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/urma/lib/uvs/core/tpsa_api.c b/src/urma/lib/uvs/core/tpsa_api.c
index 15715646..a6f37bb9 100644
--- a/src/urma/lib/uvs/core/tpsa_api.c
+++ b/src/urma/lib/uvs/core/tpsa_api.c
@@ -175,6 +175,17 @@ int uvs_get_path_set(const uvs_eid_t *src_bondind_eid,
                      uvs_path_set_t *uvs_path_set)
 {
     int ret = 0;
+
+    if (src_bondind_eid == NULL || dst_bonding_eid == NULL) {
+        TPSA_LOG_ERR("Invalid parameter.\n");
+        return -EINVAL;
+    }
+
+    if (tp_type > UVS_UTP || tp_type < UVS_RTP) {
+        TPSA_LOG_ERR("Invalid tp_type.\n");
+        return -EINVAL;
+    }
+
     if (!uvs_eid_is_valid(src_bondind_eid) ||
         !uvs_eid_is_valid(dst_bonding_eid) ||
         uvs_path_set == NULL) {
