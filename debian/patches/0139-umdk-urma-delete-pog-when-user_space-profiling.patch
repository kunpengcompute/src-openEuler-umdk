From 169f0477ca5c0146d764d5a904cb4e24b4101bc7 Mon Sep 17 00:00:00 2001
From: chenyongcheng_H <chenyongcheng4@h-partners.com>
Date: Sat, 25 Apr 2026 11:14:25 +0800
Subject: [PATCH 46/48] urma: delete pog when user_space profiling

---
 src/urma/lib/urma/core/urma_private.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/urma/lib/urma/core/urma_private.h b/src/urma/lib/urma/core/urma_private.h
index 1b1dbeef..06a44d94 100644
--- a/src/urma/lib/urma/core/urma_private.h
+++ b/src/urma/lib/urma/core/urma_private.h
@@ -80,8 +80,8 @@ uint32_t urma_ubagg_switch_get(void);
 #define UDMA_PERF_PROFILING_END(type, dev_name) \
     do { \
         uint64_t perf_end = 0; \
-        perf_end = urma_get_perf_timestamp(); \
         if (urma_perf_is_enabled() && (!urma_is_bonding_dev(dev_name))) { \
+            perf_end = urma_get_perf_timestamp(); \
             urma_step_perf(type, perf_end - __perf_start_##type); \
         } \
     } while (0); \
