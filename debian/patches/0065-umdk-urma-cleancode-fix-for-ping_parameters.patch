From 7189881eeef6758ad8bc4f92f3142d78eb9e1073 Mon Sep 17 00:00:00 2001
From: youyilin <youyilin2@huawei.com>
Date: Wed, 11 Mar 2026 08:51:34 +0800
Subject: [PATCH] urma: cleancode fix for ping_parameters

(cherry picked from commit b29cec1f3258e5559df4a1aa082aa1771055da33)
---
 src/urma/tools/urma_ping/ping_parameters.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/urma/tools/urma_ping/ping_parameters.c b/src/urma/tools/urma_ping/ping_parameters.c
index 6bd4a9d9..30457342 100644
--- a/src/urma/tools/urma_ping/ping_parameters.c
+++ b/src/urma/tools/urma_ping/ping_parameters.c
@@ -20,6 +20,8 @@
 
 #include "ping_parameters.h"
 
+#define MAX_PING_SIZE 4096
+
 int str_to_u32(const char *buf, uint32_t *u32)
 {
     unsigned long ret;
@@ -184,7 +186,7 @@ int check_args(ping_cfg_t *cfg)
         return -EINVAL;
     }
 
-    if (cfg->size > 4096) {
+    if (cfg->size > MAX_PING_SIZE) {
         LOG_ERROR("Size must be less than or equal to 4096\n");
         return -EINVAL;
     }
-- 
