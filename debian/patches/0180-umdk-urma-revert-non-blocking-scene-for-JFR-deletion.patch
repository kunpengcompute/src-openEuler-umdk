From a2ee890b7223e2286e4d3116ecc54b8e76c2a022 Mon Sep 17 00:00:00 2001
From: Bi Shulei <bishulei@huawei.com>
Date: Mon, 18 May 2026 19:43:46 +0800
Subject: [PATCH] urma: revert the non-blocking scene for JFR deletion

(cherry picked from commit 096091abc9bb2b34d01ca555d941f802ca8833c7)
---
 src/urma/lib/urma/core/include/urma_types.h |  3 +--
 src/urma/lib/urma/core/urma_cmd.c           | 13 +------------
 2 files changed, 2 insertions(+), 14 deletions(-)

diff --git a/src/urma/lib/urma/core/include/urma_types.h b/src/urma/lib/urma/core/include/urma_types.h
index f7b41422..a0ee85cd 100644
--- a/src/urma/lib/urma/core/include/urma_types.h
+++ b/src/urma/lib/urma/core/include/urma_types.h
@@ -601,9 +601,8 @@ typedef union urma_jfr_flag {
                                    /* (0x2): OI, initiator ordering */
                                    /* (0x3): OL, low layer ordering */
                                    /* (0x4): UNO, unreliable non ordering */
-        uint32_t non_blocking : 1;
         uint32_t has_drv_ext  : 1;
-        uint32_t reserved     : 17;
+        uint32_t reserved     : 18;
     } bs;
     uint32_t value;
 } urma_jfr_flag_t;
diff --git a/src/urma/lib/urma/core/urma_cmd.c b/src/urma/lib/urma/core/urma_cmd.c
index 25b86824..c20630f4 100644
--- a/src/urma/lib/urma/core/urma_cmd.c
+++ b/src/urma/lib/urma/core/urma_cmd.c
@@ -1019,20 +1019,9 @@ int urma_cmd_delete_jfr(urma_jfr_t *jfr)
         URMA_LOG_ERR("ioctl failed in urma_cmd_delete_jfr, ret=%d, errno=%d.\n", ret, errno);
     }
 
-    if (jfr->jfr_cfg.flag.bs.non_blocking == 1) {
-        (void)pthread_mutex_lock(&jfr->event_mutex);
-        if (jfr->async_events_acked != arg.out.async_events_reported) {
-            (void)pthread_mutex_unlock(&jfr->event_mutex);
-            return URMA_EAGAIN;
-        }
-
-        (void)pthread_mutex_unlock(&jfr->event_mutex);
-        return URMA_SUCCESS;
-    }
-
     wait_async_event_ack(&jfr->event_mutex, &jfr->event_cond, &jfr->async_events_acked, arg.out.async_events_reported);
 
-    return URMA_SUCCESS;
+    return ret;
 }
 
 int urma_cmd_delete_jfr_batch(urma_jfr_t **jfr_arr, int jfr_num, urma_jfr_t **bad_jfr)
-- 
2.43.0

