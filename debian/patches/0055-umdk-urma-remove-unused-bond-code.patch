-    dev_node = direct_dev_hash_table_lookup(&topo_map->direct_dev_hash_table, target_bonding_eid);
-    if (dev_node == NULL) {
-        ret = direct_dev_hash_table_add(&topo_map->direct_dev_hash_table, topo_info, local_map_idx, target_map_idx);
