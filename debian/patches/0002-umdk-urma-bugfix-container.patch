+        (void)printf("Failed to find ubep.\n");
+        goto free_list;
+    }
+
+    UB_LIST_FOR_EACH_SAFE (ubep, next, node, &ubep_list) {
+        if (ubep == NULL) {
+            break;
+        }
+        for (uint32_t i = 0; i < ubep->dev_attr.dev_cap.max_eid_cnt; i++) {
+            if (is_eid_equal(&ubep->eid_list[i].eid, eid)) {
+                ubep_info = ubep;
+                break;
+            }
+        }
+    }
+    ret = (ubep_info != NULL) ? 0 : -1;
