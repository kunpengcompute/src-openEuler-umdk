     (void)pthread_mutex_unlock(&jfc->event_mutex);
 
     return 0;
@@ -1297,9 +1297,10 @@ int urma_cmd_free_jfc(urma_jfc_t *jfc, urma_cmd_udrv_priv_t *udata)
