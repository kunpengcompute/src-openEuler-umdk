index 00000000..6c69928b
--- /dev/null
+++ b/src/urma/lib/urma/bond/bondp_netlink.c
@@ -0,0 +1,235 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Copyright (c) Huawei Technologies Co., Ltd. 2026-2026. All rights reserved.
+ * Description: bondp support netlink msg
+ * Author: Ruilang Lai
+ * Create: 2026-04-24
