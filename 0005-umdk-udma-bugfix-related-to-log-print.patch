 src/urma/hw/udma/udma_u_log.c   |  4 ++--
 src/urma/hw/udma/udma_u_log.h   |  3 ++-
 6 files changed, 25 insertions(+), 27 deletions(-)

diff --git a/src/urma/hw/udma/udma_u_ctl.c b/src/urma/hw/udma/udma_u_ctl.c
index cd4030a..d735684 100644
--- a/src/urma/hw/udma/udma_u_ctl.c
+++ b/src/urma/hw/udma/udma_u_ctl.c
@@ -8,10 +8,7 @@
  */
 
 #include <errno.h>
-#include <stdint.h>
 #include <stdio.h>
-#include <stdlib.h>
-#include <string.h>
 #include <sys/types.h>
 #include "urma_private.h"
 #include "udma_u_common.h"
@@ -21,6 +18,7 @@
 #include "udma_u_jfr.h"
 #include "udma_u_jfc.h"
 #include "udma_u_jetty.h"
+#include "udma_u_ctrlq_tp.h"
