From e7b832dce82c0bd3ddece68b53294815e036fb7e Mon Sep 17 00:00:00 2001
From: Bi Shulei <bishulei@huawei.com>
Date: Tue, 19 May 2026 19:26:28 +0800
Subject: [PATCH] urma: move log init to liburma_init constructor

(cherry picked from commit 334d2bab25e93991ca360b36558cb2bcc91c7456)
---
 src/urma/lib/urma/core/urma_main.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/src/urma/lib/urma/core/urma_main.c b/src/urma/lib/urma/core/urma_main.c
index 3746e93e..ee1205a5 100644
--- a/src/urma/lib/urma/core/urma_main.c
+++ b/src/urma/lib/urma/core/urma_main.c
@@ -211,10 +211,6 @@ static int urma_open_drivers(void)
 
 urma_status_t urma_init(urma_init_attr_t *conf)
 {
-    urma_log_init();
-    urma_getenv_log_separator();
-    urma_getenv_log_level();
-
     /* g_init_flag is initialized as 0 */
     if (atomic_load(&g_init_flag) > 0) {
         URMA_LOG_ERR("urma_init has been called before.\n");
@@ -659,6 +655,9 @@ int urma_register_sysfs_dev(struct urma_sysfs_dev *dev)
 
 static __attribute__((constructor)) void liburma_init(void)
 {
+    urma_log_init();
+    urma_getenv_log_separator();
+    urma_getenv_log_level();
 #if !defined(__OHOS__) && !defined(__OH__) && !defined(__ANDROID__)
     urma_discover_sysfs_path();
 #endif
-- 
2.43.0

