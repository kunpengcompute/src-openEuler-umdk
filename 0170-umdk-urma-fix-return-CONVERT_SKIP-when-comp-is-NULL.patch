From 06f66b4074b16251d90a41d39e1e0a4b86995296 Mon Sep 17 00:00:00 2001
From: Bi Shulei <bishulei@huawei.com>
Date: Thu, 14 May 2026 15:49:17 +0800
Subject: [PATCH] urma: fix return CONVERT_SKIP when comp is NULL

(cherry picked from commit 131d5f552c1b52b0759b26bafbbb2a6df53aff5b)
---
 src/urma/lib/urma/bond/bondp_datapath.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/urma/lib/urma/bond/bondp_datapath.c b/src/urma/lib/urma/bond/bondp_datapath.c
index 7ac1d65c..52cb81d6 100644
--- a/src/urma/lib/urma/bond/bondp_datapath.c
+++ b/src/urma/lib/urma/bond/bondp_datapath.c
@@ -947,7 +947,7 @@ static cr_convert_ret_t bondp_handle_cr_no_store(bondp_context_t *bdp_ctx, int i
 {
     bondp_comp_t *comp = get_comp_by_cr(bdp_ctx, idx, cr);
     if (comp == NULL) {
-        return CONVERT_FAIL;
+        return CONVERT_SKIP;
     }
 
     // Special handling is applied to the CRs constructed by the hardware of SUSPEND_DONE and FLUSH_ERROR_DONE.
